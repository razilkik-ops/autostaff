<%- include('partials/head') %>
<script type="application/ld+json"><%- JSON.stringify({ '@context':'https://schema.org', '@type': article.type === 'NEWS' ? 'NewsArticle' : 'Article', headline: article.title, description: article.description, image: new URL(article.heroImage, siteUrl).href, datePublished: article.publishedAt, author: { '@type':'Organization', name:'SGCB Russia' }, publisher: { '@type':'Organization', name:'SGCB Russia' } }).replace(/</g, '\\u003c') %></script>
<%- include('partials/header') %>
<main class="article-page" data-article-id="<%= article.id %>">
  <article>
    <header class="article-hero"><div class="layout-container"><div class="breadcrumbs light"><a href="/">Главная</a><span>/</span><a href="/<%= contentType %>"><%= contentType === 'blog' ? 'Блог' : 'Новости' %></a><span>/</span><span>Материал</span></div><span class="article-kind"><%= article.type === 'BLOG' ? 'Практика' : 'Новости SGCB' %></span><h1><%= article.title %></h1><p><%= article.description %></p><div class="article-meta"><span><%= formatDate(article.publishedAt) %></span><span>SGCB Russia</span></div></div></header>
    <div class="article-layout layout-container"><div class="article-main">
      <figure class="article-cover"><img src="<%= article.heroImage %>" alt="<%= article.title %>" /></figure>
      <% paragraphs(article.body).forEach((block, index) => { const lines = block.split('\n'); %><section><h2><%= lines[0] %></h2><p><%= lines.slice(1).join(' ') %></p><% if (index === 0) { %><blockquote>Профессиональный результат начинается с правильного процесса и подходящих инструментов.</blockquote><% } %></section><% }) %>
      <% if (article.videoUrl) { %><section class="video-block"><iframe src="<%= article.videoUrl %>" title="Видео к статье" loading="lazy" allowfullscreen></iframe></section><% } %>
      <% if (article.product) { %><aside class="article-product"><img src="<%= article.product.image %>" alt="<%= article.product.name %>" /><div><span>Товар из статьи</span><h3><%= article.product.name %></h3><p><%= article.product.description %></p><strong><%= formatMoney(article.product.price) %></strong></div><div><a href="/product/<%= article.product.slug %>">Подробнее</a><button type="button" class="primary add-to-cart" data-product-id="<%= article.product.id %>" data-product-name="<%= article.product.name %>" data-product-price="<%= Number(article.product.price) %>" data-product-image="<%= article.product.image %>">🛒 В корзину</button></div></aside><% } %>
      <div class="article-actions">
        <% if (user) { %><button type="button" class="<%= liked ? 'active' : '' %>" data-like-button><span><%= liked ? '♥' : '♡' %></span> <span data-like-label><%= liked ? 'Понравилось' : 'Нравится' %></span> · <span data-like-count><%= article._count.likes %></span></button><% } else { %><a href="/login?returnTo=<%= encodeURIComponent(currentPath) %>">♡ Войдите, чтобы поставить лайк · <%= article._count.likes %></a><% } %>
        <button type="button" data-share-button>⧉ Поделиться</button>
      </div>
      <section class="comments"><div class="section-title-row"><h2>Комментарии</h2><span data-comment-count><%= article._count.comments %></span></div><div data-comment-list><% article.comments.forEach(comment => { %><article><span><%= comment.user.name.slice(0, 1).toUpperCase() %></span><div><b><%= comment.user.name %></b><small><%= formatDateTime(comment.createdAt) %></small><p><%= comment.body %></p></div></article><% }) %></div>
        <% if (user) { %><form data-comment-form><label>Ваш комментарий<textarea name="body" maxlength="1000" placeholder="Поделитесь мнением" required></textarea></label><p class="form-error hidden" data-comment-error></p><button>💬 Отправить</button></form><% } else { %><div class="auth-callout"><p>Только зарегистрированные пользователи могут оставлять комментарии.</p><a href="/login?returnTo=<%= encodeURIComponent(currentPath) %>">Войти</a><a href="/register?returnTo=<%= encodeURIComponent(currentPath) %>">Зарегистрироваться</a></div><% } %>
      </section>
    </div><aside class="article-sidebar"><div class="subscribe-card"><span>➤</span><h2>Полезное — на почту</h2><p>Новые статьи и инструкции без спама.</p><form data-subscribe-form><input type="email" name="email" required placeholder="E-mail" /><button>Подписаться</button><small class="hidden" data-subscribe-message></small></form></div><div class="related-articles"><h2>Похожие материалы</h2><% related.forEach(item => { %><a href="<%= articlePath(item) %>"><img src="<%= item.heroImage %>" alt="" /><span><b><%= item.title %></b><small><%= formatDate(item.publishedAt) %></small></span></a><% }) %></div></aside></div>
  </article>
</main>
<%- include('partials/footer') %>
