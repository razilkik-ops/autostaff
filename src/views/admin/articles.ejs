<%- include('partials/head') %>
<div class="admin-page-head"><div><span>Контент</span><h1>Блог и новости</h1></div><a href="/admin/articles/new">+ Создать материал</a></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Материал</th><th>Тип</th><th>Реакции</th><th>Публикация</th><th></th></tr></thead><tbody><% articles.forEach(article => { %><tr><td><b><%= article.title %></b><small class="table-slug">/<%= article.type.toLowerCase() %>/<%= article.slug %></small></td><td><span class="status"><%= article.type === 'BLOG' ? 'Блог' : 'Новости' %></span></td><td>♥ <%= article._count.likes %> · 💬 <%= article._count.comments %></td><td><span class="status <%= article.published ? 'ok' : 'muted' %>"><%= article.published ? 'Опубликован' : 'Черновик' %></span></td><td class="table-actions"><a href="/admin/articles/<%= article.id %>/edit">Изменить</a><form action="/admin/articles/<%= article.id %>/delete" method="post" onsubmit="return confirm('Удалить материал вместе с лайками и комментариями?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button>Удалить</button></form></td></tr><% }) %></tbody></table></div>
<%- include('partials/foot') %>
