<%- include('partials/head') %>
<div class="admin-page-head"><div><span>Каталог</span><h1>Товары</h1></div><a href="/admin/products/new">+ Добавить товар</a></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Товар</th><th>Категория</th><th>Цена</th><th>Остаток</th><th>Статус</th><th></th></tr></thead><tbody><% products.forEach(product => { %><tr><td><div class="table-product"><img src="<%= product.image %>" alt="" /><span><b><%= product.name %></b><small><%= product.sku %></small></span></div></td><td><%= product.category.name %></td><td><%= formatMoney(product.price) %></td><td><%= product.stock %></td><td><span class="status <%= product.published ? 'ok' : 'muted' %>"><%= product.published ? 'Опубликован' : 'Черновик' %></span></td><td class="table-actions"><a href="/admin/products/<%= product.id %>/edit">Изменить</a><form action="/admin/products/<%= product.id %>/delete" method="post" onsubmit="return confirm('Удалить товар?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button>Удалить</button></form></td></tr><% }) %></tbody></table></div>
<%- include('partials/foot') %>
