<%- include('partials/head') %>
<div class="admin-page-head"><div><span>Контент</span><h1><%= article ? 'Редактирование материала' : 'Новый материал' %></h1></div><a class="secondary" href="/admin/articles">← Назад</a></div>
<% if (formError) { %><div class="admin-alert error"><%= formError %></div><% } %>
<form class="admin-form" action="<%= article?.id ? `/admin/articles/${article.id}` : '/admin/articles' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><div class="form-grid"><label>Тип<select name="type"><option value="BLOG" <%= article?.type !== 'NEWS' ? 'selected' : '' %>>Блог</option><option value="NEWS" <%= article?.type === 'NEWS' ? 'selected' : '' %>>Новости</option></select></label><label>Связанный товар<select name="productId"><option value="">Без товара</option><% products.forEach(product => { %><option value="<%= product.id %>" <%= article?.productId === product.id ? 'selected' : '' %>><%= product.name %></option><% }) %></select></label><label class="wide">Заголовок<input name="title" required maxlength="180" value="<%= article?.title || '' %>" /></label><label class="wide">Slug<input name="slug" maxlength="180" value="<%= article?.slug || '' %>" placeholder="создастся автоматически" /></label><label class="wide">SEO-описание<textarea name="description" required maxlength="500" rows="3"><%= article?.description || '' %></textarea></label><label class="wide">Изображение<input name="heroImage" required value="<%= article?.heroImage || '/assets/sgcb-tools-banner-ru.jpg' %>" /></label><label class="wide">Видео embed URL <small>необязательно</small><input name="videoUrl" value="<%= article?.videoUrl || '' %>" placeholder="https://www.youtube-nocookie.com/embed/..." /></label><label class="wide">Текст статьи <small>Каждый блок: заголовок на первой строке, текст ниже; блоки разделяются пустой строкой.</small><textarea name="body" required rows="18"><%= article?.body || '' %></textarea></label><label class="check"><input name="published" type="checkbox" <%= article?.published ? 'checked' : '' %> /> Опубликовать</label></div><button class="admin-submit"><%= article ? 'Сохранить изменения' : 'Создать материал' %></button></form>
<%- include('partials/foot') %>
