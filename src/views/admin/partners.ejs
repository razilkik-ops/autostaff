<%- include('partials/head') %>
<div class="admin-page-head"><div><span>Контент</span><h1>Наши партнёры</h1></div><a class="secondary" href="/partners" target="_blank">Посмотреть на сайте ↗</a></div>
<p class="admin-intro">Добавьте подтверждённых партнёров. Укажите логотип, сайт и порядок показа; без логотипа появится название.</p>
<div class="admin-partners"><% partners.forEach(partner => { %><form class="admin-form admin-partner-form" action="/admin/partners/<%= partner.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><div class="form-grid"><label>Название<input name="name" maxlength="120" required value="<%= partner.name %>" /></label><label>Порядок<input name="sortOrder" type="number" value="<%= partner.sortOrder %>" /></label><label class="wide">Логотип: адрес изображения или путь /uploads/...<input name="logo" maxlength="500" value="<%= partner.logo || '' %>" /></label><label class="wide">Сайт партнёра<input name="url" type="url" maxlength="500" value="<%= partner.url || '' %>" /></label><label class="wide">Краткое описание<textarea name="description" maxlength="300" rows="2"><%= partner.description || '' %></textarea></label><label class="check"><input name="published" type="checkbox" <%= partner.published ? 'checked' : '' %> /> Показывать на сайте</label></div><div class="admin-partner-actions"><button class="admin-submit">Сохранить</button><button class="danger" formaction="/admin/partners/<%= partner.id %>/delete" onclick="return confirm('Удалить партнёра?')">Удалить</button></div></form><% }) %></div>
<form class="admin-form admin-partner-form" action="/admin/partners" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><h2>Добавить партнёра</h2><div class="form-grid"><label>Название<input name="name" maxlength="120" required /></label><label>Порядок<input name="sortOrder" type="number" value="0" /></label><label class="wide">Логотип: адрес изображения или путь /uploads/...<input name="logo" maxlength="500" /></label><label class="wide">Сайт партнёра<input name="url" type="url" maxlength="500" /></label><label class="wide">Краткое описание<textarea name="description" maxlength="300" rows="2"></textarea></label><label class="check"><input name="published" type="checkbox" checked /> Показывать на сайте</label></div><button class="admin-submit">Добавить партнёра</button></form>
<%- include('partials/foot') %>
