<%- include('partials/head') %>
<div class="admin-page-head"><div><span>Каталог</span><h1>Категории</h1></div></div>
<form class="admin-inline-form" action="/admin/categories" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input name="name" required placeholder="Название" /><input name="slug" placeholder="slug" /><input name="description" placeholder="SEO-описание категории" /><input name="image" placeholder="/assets/image.png" /><input name="sortOrder" type="number" value="0" aria-label="Порядок" /><button>Добавить</button></form>
<div class="admin-category-list"><% categories.forEach(category => { %><form action="/admin/categories/<%= category.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><img src="<%= category.image || '/favicon.png' %>" alt="" /><label>Название<input name="name" value="<%= category.name %>" required /></label><label>Slug<input name="slug" value="<%= category.slug %>" required /></label><label>SEO-описание<input name="description" value="<%= category.description || '' %>" /></label><label>Изображение<input name="image" value="<%= category.image || '' %>" /></label><label>Порядок<input name="sortOrder" type="number" value="<%= category.sortOrder %>" /></label><span><%= category._count.products %> товаров</span><button>Сохранить</button><button class="danger" formaction="/admin/categories/<%= category.id %>/delete" onclick="return confirm('Удалить категорию?')">Удалить</button></form><% }) %></div>
<%- include('partials/foot') %>
