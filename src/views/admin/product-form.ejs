<%- include('partials/head') %>
<div class="admin-page-head"><div><span>Каталог</span><h1><%= product ? 'Редактирование товара' : 'Новый товар' %></h1></div><a class="secondary" href="/admin/products">← Назад</a></div>
<% if (formError) { %><div class="admin-alert error"><%= formError %></div><% } %>
<form class="admin-form" action="<%= product?.id ? `/admin/products/${product.id}` : '/admin/products' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><div class="form-grid"><label class="wide">Название<input name="name" required maxlength="180" value="<%= product?.name || '' %>" /></label><label>Короткое название<input name="shortName" maxlength="120" value="<%= product?.shortName || '' %>" /></label><label>Slug<input name="slug" maxlength="180" value="<%= product?.slug || '' %>" placeholder="создастся автоматически" /></label><label>Бренд<input name="brand" maxlength="80" value="<%= product?.brand || 'SGCB' %>" /></label><label>Артикул<input name="sku" required maxlength="80" value="<%= product?.sku || '' %>" /></label><label>Цена, ₽<input name="price" type="number" min="0" step="0.01" required value="<%= product ? Number(product.price) : '' %>" /></label><label>Остаток<input name="stock" type="number" min="0" required value="<%= product?.stock ?? 0 %>" /></label><label>Категория<select name="categoryId" required><option value="">Выберите</option><% categories.forEach(category => { %><option value="<%= category.id %>" <%= product?.categoryId === category.id ? 'selected' : '' %>><%= category.name %></option><% }) %></select></label><label class="wide">Путь к изображению<input name="image" required value="<%= product?.image || '/assets/' %>" /></label><label class="wide">Описание<textarea name="description" required rows="5"><%= product?.description || '' %></textarea></label><label class="wide">Характеристики <small>Одна строка: Название: Значение</small><textarea name="specs" rows="7"><%= specsToText(product?.specs) %></textarea></label><label class="check"><input name="published" type="checkbox" <%= product?.published ?? true ? 'checked' : '' %> /> Опубликовать</label></div><button class="admin-submit"><%= product ? 'Сохранить изменения' : 'Создать товар' %></button></form>
<%- include('partials/foot') %>
