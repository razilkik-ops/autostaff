<!doctype html><html lang="ru"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="csrf-token" content="<%= csrfToken %>" /><meta name="description" content="<%= description %>" /><link rel="stylesheet" href="/styles/app.css?v=20260925-gallery" /><title><%= title %></title></head><body class="admin-body">
<header class="admin-top"><a class="admin-logo" href="/admin">SGCB <span>ADMIN</span></a><nav><a href="/">Сайт</a><span><%= user.name %></span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button>Выйти</button></form></nav></header>
<div class="admin-shell"><aside class="admin-nav"><a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">Обзор</a><a href="/admin/products" class="<%= currentPath.startsWith('/admin/products') ? 'active' : '' %>">Товары</a><a href="/admin/categories" class="<%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>">Категории</a><a href="/admin/articles" class="<%= currentPath.startsWith('/admin/articles') ? 'active' : '' %>">Блог и новости</a><a href="/admin/comments" class="<%= currentPath.startsWith('/admin/comments') ? 'active' : '' %>">Комментарии</a><a href="/admin/reviews" class="<%= currentPath.startsWith('/admin/reviews') ? 'active' : '' %>">Отзывы</a><a href="/admin/orders" class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>">Заказы</a></aside><main class="admin-main"><% if (query.success) { %><div class="admin-alert success"><%= query.success %></div><% } %><% if (query.error) { %><div class="admin-alert error"><%= query.error %></div><% } %>
