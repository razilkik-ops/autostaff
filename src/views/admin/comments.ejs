<%- include('partials/head') %>
<div class="admin-page-head"><div><span>Сообщество</span><h1>Комментарии</h1></div></div>
<div class="admin-comments"><% comments.forEach(comment => { %><article><div><span><%= comment.user.name.slice(0,1).toUpperCase() %></span><div><b><%= comment.user.name %></b><small><%= comment.user.email %> · <%= formatDateTime(comment.createdAt) %></small></div></div><p><%= comment.body %></p><a href="<%= articlePath(comment.article) %>" target="_blank"><%= comment.article.title %></a><div><span class="status <%= comment.status === 'VISIBLE' ? 'ok' : 'muted' %>"><%= comment.status === 'VISIBLE' ? 'Показывается' : 'Скрыт' %></span><form action="/admin/comments/<%= comment.id %>/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button><%= comment.status === 'VISIBLE' ? 'Скрыть' : 'Показать' %></button></form><form action="/admin/comments/<%= comment.id %>/delete" method="post" onsubmit="return confirm('Удалить комментарий?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="danger">Удалить</button></form></div></article><% }) %></div>
<%- include('partials/foot') %>
