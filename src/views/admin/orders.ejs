<%- include('partials/head') %>
<div class="admin-page-head"><div><span>Продажи</span><h1>Заказы</h1></div></div>
<div class="admin-orders"><% orders.forEach(order => { %><article><header><div><b><%= order.number %></b><span><%= formatDateTime(order.createdAt) %></span></div><strong><%= formatMoney(order.total) %></strong></header><div class="order-customer"><p><b><%= order.customerName %></b><br /><a href="tel:<%= order.phone %>"><%= order.phone %></a><% if (order.email) { %><br /><a href="mailto:<%= order.email %>"><%= order.email %></a><% } %></p><p><%= order.delivery %><% if (order.comment) { %><br /><small><%= order.comment %></small><% } %></p></div><ul><% order.items.forEach(item => { %><li><span><%= item.quantity %> × <%= item.productName %></span><b><%= formatMoney(Number(item.price) * item.quantity) %></b></li><% }) %></ul><form action="/admin/orders/<%= order.id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><select name="status"><% [['NEW','Новый'],['PROCESSING','В работе'],['COMPLETED','Отправлен / готов к выдаче'],['DELIVERED','Получен клиентом'],['CANCELLED','Отменён']].forEach(([value,label]) => { %><option value="<%= value %>" <%= order.status === value ? 'selected' : '' %>><%= label %></option><% }) %></select><button>Обновить статус</button></form></article><% }) %></div>
<%- include('partials/foot') %>
