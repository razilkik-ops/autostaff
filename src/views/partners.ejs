<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="partners-page layout-container"><div class="breadcrumbs"><a href="/">Главная</a><span>/</span><span>Наши партнёры</span></div><div class="contact-heading"><span>СОТРУДНИЧЕСТВО</span><h1>Наши партнёры</h1><p>Компании и специалисты, с которыми мы развиваем профессиональный уход за автомобилями.</p></div><% if (partners.length) { %><div class="partner-grid"><% partners.forEach(partner => { %><article class="partner-card"><% if (partner.logo) { %><img src="<%= partner.logo %>" alt="Логотип <%= partner.name %>" /><% } %><h2><%= partner.name %></h2><% if (partner.description) { %><p><%= partner.description %></p><% } %><% if (partner.url) { %><a href="<%= partner.url %>" target="_blank" rel="noopener noreferrer">Сайт партнёра →</a><% } %></article><% }) %></div><% } else { %><div class="partner-empty"><p>Список партнёров готовится к публикации.</p><a href="/contacts">Обсудить сотрудничество →</a></div><% } %></main>
<%- include('partials/footer') %>
