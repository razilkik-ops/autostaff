<%- include('partials/head') %>
<script type="application/ld+json"><%- JSON.stringify({ '@context':'https://schema.org', '@type':'Product', name:product.name, description:product.description, image:gallery.map(item => new URL(item, siteUrl).href), sku:product.sku, brand:{'@type':'Brand',name:product.brand}, offers:{'@type':'Offer',price:Number(product.price),priceCurrency:'RUB',availability:product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',url:canonicalUrl} }).replace(/</g, '\\u003c') %></script>
<%- include('partials/header') %>
<main class="product-page layout-container">
  <div class="breadcrumbs"><a href="/">Главная</a><span>/</span><a href="/catalog/<%= product.category.slug %>"><%= product.category.name %></a><span>/</span><span><%= product.shortName %></span></div>
  <div class="product-detail">
    <div class="product-gallery"><div class="product-gallery-main"><img src="<%= gallery[0] %>" alt="<%= product.name %>" data-gallery-main /></div><div class="product-thumbnails" aria-label="Фотографии товара"><% gallery.forEach((image, index) => { %><button type="button" class="<%= index === 0 ? 'active' : '' %>" data-gallery-thumb data-gallery-src="<%= image %>" aria-label="Фото <%= index + 1 %>: <%= product.name %>"><img src="<%= image %>" alt="" /></button><% }) %></div></div>
    <section class="product-info"><span class="product-brand"><%= product.brand %></span><h1><%= product.name %></h1><div class="product-meta"><span>★★★★★</span><span>Артикул: <%= product.sku %></span></div><p class="detail-description"><%= product.description %></p><div class="stock"><%= product.stock > 0 ? '✓ В наличии' : 'Нет в наличии' %></div><div class="buy-box"><strong><%= formatMoney(product.price) %></strong><button type="button" class="add-detail add-to-cart" data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" data-product-price="<%= Number(product.price) %>" data-product-image="<%= product.image %>" <%= product.stock < 1 ? 'disabled' : '' %>>🛒 Добавить в корзину</button></div><div class="detail-benefits"><div>▣<span><b>Доставка по России</b><small>Срок рассчитает менеджер</small></span></div><div>♢<span><b>Гарантия качества</b><small>Возврат в течение 14 дней</small></span></div></div></section>
  </div>
  <section class="product-description"><div><h2>О товаре</h2><p><%= product.description %></p></div><div><h2>Характеристики</h2><dl><% (Array.isArray(product.specs) ? product.specs : []).forEach(spec => { %><div><dt><%= spec[0] %></dt><dd><%= spec[1] %></dd></div><% }) %></dl></div></section>
  <% if (related.length) { %><section class="related"><div class="section-title-row"><h2>С этим товаром покупают</h2><a href="/catalog/<%= product.category.slug %>">Вся категория →</a></div><div class="related-grid"><% related.forEach(item => { %><%- include('partials/product-card', { product: item }) %><% }) %></div></section><% } %>
</main>
<%- include('partials/footer') %>
