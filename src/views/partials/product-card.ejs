<article class="product-card">
  <% if (user) { %><form class="favorite-form" action="/account/favorites/<%= product.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="returnTo" value="<%= currentPath %>" /><button type="submit" aria-label="<%= favoriteIds?.has(product.id) ? 'Убрать из избранного' : 'Добавить в избранное' %>" title="Избранное"><img src="/assets/favorite-heart-<%= favoriteIds?.has(product.id) ? 'filled' : 'outline' %>.png" alt="" /></button></form><% } else { %><a class="favorite-form favorite-login" href="/login?returnTo=<%= encodeURIComponent(currentPath) %>" aria-label="Войти, чтобы добавить в избранное"><img src="/assets/favorite-heart-outline.png" alt="" /></a><% } %>
  <a class="product-link" href="/product/<%= product.slug %>">
    <img src="<%= product.image %>" alt="<%= product.name %>" />
    <span class="product-brand"><%= product.brand %></span>
    <h3><%= product.name %></h3>
  </a>
  <div class="rating">Отзывов: <%= product._count?.reviews || 0 %></div>
  <div class="product-bottom">
    <b><%= formatMoney(product.price) %></b>
    <button type="button" class="add-to-cart" data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" data-product-price="<%= Number(product.price) %>" data-product-image="<%= product.image %>" aria-label="Добавить в корзину"><img src="/assets/process-cart.png" alt="" /></button>
  </div>
</article>
