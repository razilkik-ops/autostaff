<div class="overlay hidden" data-cart-overlay>
  <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <div class="drawer-head"><div><span>Ваш заказ</span><h2 id="cart-title">Корзина</h2></div><button type="button" data-cart-close aria-label="Закрыть">×</button></div>
    <div class="cart-lines" data-cart-lines></div>
    <div class="cart-summary" data-cart-summary>
      <div class="total"><b>Итого</b><strong data-cart-total>0 ₽</strong></div>
      <button type="button" data-checkout-open>Оформить заказ →</button>
    </div>
  </aside>
</div>

<div class="overlay checkout-overlay hidden" data-checkout-overlay>
  <section class="checkout-modal" role="dialog" aria-modal="true" aria-labelledby="checkout-title">
    <div class="drawer-head"><div><span>Остался один шаг</span><h2 id="checkout-title">Оформление заказа</h2></div><button type="button" data-checkout-close aria-label="Закрыть">×</button></div>
    <form data-checkout-form>
      <label>Ваше имя<input name="customerName" required maxlength="80" value="<%= user?.name || '' %>" placeholder="Алексей" /></label>
      <label>Телефон<input name="phone" type="tel" required maxlength="32" placeholder="+7 900 000-00-00" /></label>
      <label>E-mail<input name="email" type="email" maxlength="254" value="<%= user?.email || '' %>" placeholder="mail@example.ru" /></label>
      <label>Способ получения<select name="delivery"><option>Доставка по России</option><option>Самовывоз во Владимире</option></select></label>
      <label>Комментарий<textarea name="comment" maxlength="600" placeholder="Детали заказа"></textarea></label>
      <p class="form-error hidden" data-checkout-error></p>
      <button class="submit-order">Отправить заказ →</button>
    </form>
  </section>
</div>
<div class="toast hidden" data-toast></div>
<script src="/js/app.js" defer></script>
</body>
</html>
