<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="hero" aria-labelledby="hero-title" style="background-image:url('/assets/hero-auto.png')">
  <div class="layout-container hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title"><span>SGCB</span><br />ТОВАРЫ ДЛЯ ДЕТЕЙЛИНГА<br />И УХОДА ЗА АВТО</h1>
      <p class="hero-lead">Автохимия, микрофибра, аксессуары и оборудование для детейлинг-центров, автомоек и частных мастеров. Защитные плёнки PPF. Доставка по России и Беларуси.</p>
    </div>
    <img class="hero-badge" src="/assets/hero-badge.png" alt="Чистый авто больше, чем просто внешность" />
    <div class="hero-features"><div class="hero-feature"><img src="/assets/benefit-quality.png" alt="" /><span><b>Проверенное</b><small>качество</small></span></div><div class="hero-feature"><img src="/assets/benefit-delivery.png" alt="" /><span><b>Быстрая</b><small>доставка</small></span></div><div class="hero-feature"><img src="/assets/process-payment.png" alt="" /><span><b>Удобная</b><small>оплата</small></span></div><div class="hero-feature"><img src="/assets/benefit-support.png" alt="" /><span><b>Поможем</b><small>с выбором</small></span></div></div>
  </div>
</section>
<main class="content"><div class="layout-container content-inner">
  <section class="how" id="how"><div class="section-heading"><h2>КАК СДЕЛАТЬ ПОКУПКУ?</h2><p>Простой и понятный процесс от выбора до получения</p></div><div class="steps"><% [['01','/assets/process-search.png','Выбираете товары','Находите нужную автохимию и оборудование'],['02','/assets/process-cart.png','Оформляете заказ','Добавляете товары в корзину'],['03','/assets/process-payment.png','Подтверждаете','Указываете данные для связи'],['04','/assets/process-package.png','Получаете заказ','Доставим по России и Беларуси или подготовим самовывоз']].forEach(step => { %><article class="step"><div class="step-icon"><img src="<%= step[1] %>" alt="" /></div><div><span class="step-number"><%= step[0] %></span><h3><%= step[2] %></h3><p><%= step[3] %></p></div></article><% }) %></div></section>
  <section class="categories" id="categories"><div class="section-title-row"><h2>КАТЕГОРИИ ТОВАРОВ</h2><a href="#categories">Все направления SGCB →</a></div><div class="category-grid"><% categories.forEach(category => { %><a class="category-card" href="/catalog/<%= category.slug %>"><img src="<%= category.image %>" alt="<%= category.name %> SGCB" /><span><%= category.name %></span></a><% }) %></div></section>
  <section class="products" id="catalog"><div class="products-heading"><h2>ТОВАРЫ SGCB</h2><nav class="tabs" aria-label="Подборка товаров"><a href="/#catalog" class="<%= activeTab === 'popular' ? 'active' : '' %>" <%- activeTab === 'popular' ? 'aria-current="page"' : '' %>>Хиты продаж</a><a href="/?tab=new#catalog" class="<%= activeTab === 'new' ? 'active' : '' %>" <%- activeTab === 'new' ? 'aria-current="page"' : '' %>>Новинки</a><a href="/?tab=sale#catalog" class="<%= activeTab === 'sale' ? 'active' : '' %>" <%- activeTab === 'sale' ? 'aria-current="page"' : '' %>>Акции</a></nav></div><% if (products.length) { %><div class="product-grid"><% products.forEach(product => { %><%- include('partials/product-card', { product }) %><% }) %></div><% } else { %><div class="catalog-empty"><h3>Акций пока нет</h3><p>Следите за новостями: товары с пометкой «Акция» появятся здесь.</p><a href="/#catalog">Посмотреть все товары →</a></div><% } %></section>
  <section class="knowledge" id="blog"><div class="section-title-row"><div><h2>ПОЛЕЗНОЕ О ДЕТЕЙЛИНГЕ</h2><p>Практические статьи для профессионалов и автолюбителей</p></div><a href="/blog">Все статьи →</a></div><div class="article-grid"><% articles.forEach(article => { %><%- include('partials/article-card', { article }) %><% }) %></div></section>
  <section class="knowledge news-section" id="news"><div class="section-title-row"><div><h2>НОВОСТИ SGCB</h2><p>Новые товары, события и обновления</p></div><a href="/news">Все новости →</a></div><div class="article-grid"><% news.forEach(article => { %><%- include('partials/article-card', { article }) %><% }) %></div></section>
  <section class="partners-section" id="partners"><div class="section-title-row"><div><h2>НАШИ ПАРТНЁРЫ</h2><p>Вместе развиваем профессиональный уход за автомобилями</p></div><a href="/partners">Все партнёры →</a></div><% if (partners.length) { %><div class="partner-grid"><% partners.forEach(partner => { %><a class="partner-card" href="<%= partner.url || '/partners' %>" <%- partner.url ? 'target="_blank" rel="noopener noreferrer"' : '' %>><% if (partner.logo) { %><img src="<%= partner.logo %>" alt="<%= partner.name %>" /><% } else { %><strong><%= partner.name %></strong><% } %><span><%= partner.name %></span></a><% }) %></div><% } else { %><div class="partner-empty"><p>Информация о партнёрах скоро появится здесь.</p><a href="/contacts">Предложить сотрудничество →</a></div><% } %></section>
  <a class="promo campaign-promo" href="/#catalog"><img src="/assets/sgcb-tools-banner-ru.jpg" alt="Профессиональные инструменты SGCB для детейлинг-студий" /></a>
</div></main>
<%- include('partials/footer') %>
