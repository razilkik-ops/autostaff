<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="hero" aria-labelledby="hero-title" style="background-image:url('/assets/hero-auto.png')">
  <div class="layout-container hero-inner">
    <div class="hero-copy"><p class="eyebrow">SGCB — профессиональный детейлинг</p><h1 id="hero-title">ТОВАРЫ<br /><span>ДЛЯ ДЕТЕЙЛИНГА</span><br />И УХОДА ЗА АВТО</h1><p class="hero-lead">Автохимия, микрофибра, оборудование<br />и защитные плёнки для безупречного результата</p></div>
    <img class="hero-badge" src="/assets/hero-badge.png" alt="Чистый авто больше, чем просто внешность" />
    <div class="hero-features"><div class="hero-feature"><b>◇</b><span><b>Проверенное</b><small>качество</small></span></div><div class="hero-feature"><b>▣</b><span><b>Быстрая</b><small>доставка</small></span></div><div class="hero-feature"><b>♢</b><span><b>Удобная</b><small>оплата</small></span></div><div class="hero-feature"><b>◉</b><span><b>Поможем</b><small>с выбором</small></span></div></div>
  </div>
</section>
<main class="content"><div class="layout-container content-inner">
  <section class="how" id="how"><div class="section-heading"><h2>КАК СДЕЛАТЬ ПОКУПКУ?</h2><p>Простой и понятный процесс от выбора до получения</p></div><div class="steps"><% [['01','⌕','Выбираете товары','Находите нужную автохимию и оборудование'],['02','🛒','Оформляете заказ','Добавляете товары в корзину'],['03','▣','Подтверждаете','Указываете данные для связи'],['04','□','Получаете заказ','Доставим по России или подготовим самовывоз']].forEach(step => { %><article class="step"><div class="step-icon"><%= step[1] %></div><div><span class="step-number"><%= step[0] %></span><h3><%= step[2] %></h3><p><%= step[3] %></p></div></article><% }) %></div></section>
  <section class="categories" id="categories"><div class="section-title-row"><h2>КАТЕГОРИИ ТОВАРОВ</h2><a href="#categories">Все направления SGCB →</a></div><div class="category-grid"><% categories.forEach(category => { %><a class="category-card" href="/catalog/<%= category.slug %>"><img src="<%= category.image %>" alt="<%= category.name %> SGCB" /><span><%= category.name %></span></a><% }) %></div></section>
  <section class="products" id="catalog"><div class="products-heading"><h2>ПОПУЛЯРНЫЕ ТОВАРЫ</h2><div class="tabs"><span class="active">Хиты продаж</span><span>Новинки</span><span>Акции</span></div></div><div class="product-grid"><% products.forEach(product => { %><%- include('partials/product-card', { product }) %><% }) %></div></section>
  <section class="knowledge"><div class="section-title-row"><div><h2>ПОЛЕЗНОЕ О ДЕТЕЙЛИНГЕ</h2><p>Практические статьи и новости индустрии</p></div><a href="/blog">Все статьи →</a></div><div class="article-grid"><% articles.forEach(article => { %><%- include('partials/article-card', { article }) %><% }) %></div></section>
  <a class="promo campaign-promo" href="#catalog"><img src="/assets/sgcb-tools-banner.jpg" alt="Профессиональные инструменты SGCB для детейлинг-студий" /></a>
</div></main>
<%- include('partials/footer') %>
